# Copie este archivo como .env y ajuste los valores.

# --- Django ---
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción, ej.: https://soporte.janotec.com.co
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- MySQL ---
DB_ENGINE=mysql
DB_NAME=janotec_tickets
DB_USER=janotec
DB_PASSWORD=cambie-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Correo (en desarrollo se imprime en la consola) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Hostinger: EMAIL_HOST=smtp.hostinger.com, EMAIL_PORT=465, EMAIL_USE_SSL=True, EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Soporte JANOTEC <soporte@janotec.com.co>
NOTIFICAR_SOPORTE_EMAIL=soporte@janotec.com.co
# Oportunidades comerciales detectadas por los técnicos (si se deja vacío, van al buzón de soporte)
NOTIFICAR_COMERCIAL_EMAIL=
# Área SST / HSE: recibe la solicitud de acompañamiento cuando el cliente acepta una visita marcada con SST
NOTIFICAR_SST_EMAIL=
# Área administrativa: recibe el cronograma consolidado de cada semana (todas las sedes)
NOTIFICAR_ADMINISTRATIVA_EMAIL=
SITIO_URL=http://127.0.0.1:8000

# --- Tickets ---
RADICADO_PREFIJO=JNT
# Días que espera un ticket resuelto la confirmación del cliente antes de cerrarse solo
TICKET_DIAS_CIERRE_AUTOMATICO=3
ADJUNTO_MAX_MB=10
ADJUNTO_EXTENSIONES=pdf,jpg,jpeg,png,webp,mp4,docx,xlsx,txt,zip

# Fase de pruebas: todo correo para clientes llega a este buzón (el personal recibe normal). Vacío = envío real.
CORREO_CLIENTES_PRUEBA=
